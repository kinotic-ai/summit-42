# The Kinotic management gateway this UI signs in to and connects to (REST and STOMP share it).
# Local Kinotic (the defaults when unset):
VITE_KINOTIC_HOST=localhost
VITE_KINOTIC_PORT=58503
VITE_KINOTIC_USE_SSL=false

# The Kinotic development server:
# VITE_KINOTIC_HOST=dev-api.kinotic.ai
# VITE_KINOTIC_PORT=443
# VITE_KINOTIC_USE_SSL=true

# The Summit 42 server the email sign-up posts to; unset, this page's own origin, which `bun run dev` forwards to
# the server on localhost:8080
# VITE_SUMMIT42_API_URL=https://dev-summit42-api.kinotic.ai
